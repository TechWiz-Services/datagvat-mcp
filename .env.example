# Copy to .env (git-ignored) and adjust. Used by docker compose.
# Lines starting with "#" show the default; remove the "#" to change a value.
# The README explains every setting.

# --- Access ------------------------------------------------------------------

# Clients must send "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
DATAGVAT_AUTH_TOKEN=

# Only accept these Host headers (DNS-rebinding protection), comma-separated. Empty: off.
#DATAGVAT_ALLOWED_HOSTS=
#DATAGVAT_HOST=0.0.0.0
#DATAGVAT_PORT=8000
#DATAGVAT_PATH=/mcp
#DATAGVAT_STATELESS=false
#DATAGVAT_LOG_LEVEL=INFO
# Proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (only affects logged client IPs).
#FORWARDED_ALLOW_IPS=127.0.0.1

# --- Politeness towards data.gv.at -------------------------------------------

# E-mail address or URL sent to data.gv.at in the User-Agent, so they can reach you
# instead of blocking you if something goes wrong.
DATAGVAT_CONTACT=

# Seconds to pause after each answer from data.gv.at. Requests are never sent in parallel.
# data.gv.at publishes no limit; 2 s is what the Federal Chancellery asks of automated
# clients of its RIS service. Lower it at your own risk: your IP address is the one that gets blocked.
#DATAGVAT_REQUEST_INTERVAL=2
# The same pause for downloads from each publisher's file server. These are often small
# municipal servers, so think twice before lowering it.
#DATAGVAT_PREVIEW_REQUEST_INTERVAL=2
# Seconds a request may wait for its turn before the tool reports "busy".
#DATAGVAT_QUEUE_TIMEOUT=60
#DATAGVAT_REQUEST_TIMEOUT=30
#DATAGVAT_API_BASE=https://www.data.gv.at/api/hub/search
# Preferred language for labels (falls back to de, then en).
#DATAGVAT_LANGUAGE=de

# --- Previews of data files --------------------------------------------------

#DATAGVAT_PREVIEW_MAX_BYTES=524288
# Hosts (with subdomains) the preview tools never download from. The default blocks the
# legal information system RIS. Set it to an empty value to allow every host.
#DATAGVAT_PREVIEW_BLOCKED_HOSTS=ris.bka.gv.at,data.bka.gv.at

# --- Cache -------------------------------------------------------------------
# Lifetimes in seconds, size limits in MB, per kind of answer. 0 switches a kind off.

# false: nothing is saved and no saved copy is served. Only for debugging.
#DATAGVAT_CACHE_ENABLED=true
# Directory inside the container; the compose file mounts a volume there.
#DATAGVAT_CACHE_DIR=/cache
#DATAGVAT_CACHE_SEARCH_TTL=21600
#DATAGVAT_CACHE_SEARCH_MAX_MB=64
#DATAGVAT_CACHE_DATASET_TTL=604800
#DATAGVAT_CACHE_DATASET_MAX_MB=128
#DATAGVAT_CACHE_CATALOGUE_TTL=604800
#DATAGVAT_CACHE_CATALOGUE_MAX_MB=16
#DATAGVAT_CACHE_VOCABULARY_TTL=2592000
#DATAGVAT_CACHE_VOCABULARY_MAX_MB=32
#DATAGVAT_CACHE_PREVIEW_TTL=3600
#DATAGVAT_CACHE_PREVIEW_MAX_MB=64
# How long past its lifetime an answer is kept for when the source cannot be reached.
#DATAGVAT_CACHE_MAX_STALE=2592000
